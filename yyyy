​<!-- ==================== 스크립트 엔진 ==================== -->
<script>
// 기본 셋업 데이터
const initChecklist = [
{ id: 1, text: "신규 투입 근로자 위험성평가 안전교육 실시 유무", checked: true },
{ id: 2, text: "고소작업 안전대 체결 설비 및 안전고리 체결 확인", checked: false },
{ id: 3, text: "밀폐공간 가스 농도 측정 결과 허용범위 확인", checked: false },
{ id: 4, text: "가설 통로 가설 계단 발판 고정 및 난간대 확인", checked: true }
];
​const initNotices = [
{
id: 1,
priority: "important",
title: "작업장 내 소화 설비 점검 및 화재감시자 전담 배치 지침",
content: "금일 실내 용접·용단 작업을 진행하는 모든 팀은 사전 임시소방시설을 비치하고, 단독 화재감시자를 전단 배치한 후 작업을 진행하시기 바랍니다.",
date: "2026-07-01"
}
];
​const initBoards = [
{
id: 1,
location: "B구역 2층 하역장 인근",
danger: "지게차 전용 이동선 내 자재 더미 무단 적치로 인해 보행자 우회 충돌 우려 발견.",
action: "지게차 통제 조치 및 관리 책임자 소집 자재 정리 유도 조치 완료.",
date: "2026-07-01"
}
];
​// 앱 상태 데이터 모델
let appData = {
siteName: "서울 가산 복합시설 신축공사",
safetyStartDate: "2026-02-27",
checklist: [...initChecklist],
notices: [...initNotices],
boards: [...initBoards]
};
​// 초기화 실행
window.addEventListener('DOMContentLoaded', function() {
loadLocalData();
updateAllUI();
});
​// 데이터 동기화 관리
function loadLocalData() {
const stored = localStorage.getItem('SAFETY_AGENT_LOCAL_DB');
if (stored) {
try {
appData = JSON.parse(stored);
} catch(e) {
console.error("데이터 로드 오류", e);
}
}
}
​function saveData() {
localStorage.setItem('SAFETY_AGENT_LOCAL_DB', JSON.stringify(appData));
}
​// UI 업데이트 엔진
function updateAllUI() {
document.getElementById('site-title').innerText = appData.siteName;
document.getElementById('safety-start-date').innerText = appData.safetyStartDate.replace(/-/g, '. ');
​const start = new Date(appData.safetyStartDate);
const today = new Date();
const diffTime = Math.abs(today - start);
const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
document.getElementById('header-dday').innerText = diffDays;
​const weekDays = ['일', '월', '화', '수', '목', '금', '토'];
const year = today.getFullYear();
const month = String(today.getMonth() + 1).padStart(2, '0');
const date = String(today.getDate()).padStart(2, '0');
const dayName = weekDays[today.getDay()];
document.getElementById('current-date').innerText = ${year}. ${month}. ${date} (${dayName});
​renderChecklist();
renderNotices();
renderBoards();
}
​// 탭 브라우징 시스템
function switchTab(tabId) {
document.querySelectorAll('.page-content').forEach(el => el.classList.remove('active'));
document.getElementById(page-${tabId}).classList.add('active');
​const tabs = ['home', 'notice', 'board'];
tabs.forEach(t => {
const el = document.getElementById(tab-${t});
if (t === tabId) {
el.classList.add('text-slate-900', 'font-bold');
el.classList.remove('text-slate-400');
} else {
el.classList.remove('text-slate-900', 'font-bold');
el.classList.add('text-slate-400');
}
});
window.scrollTo(0, 0);
}
​// 모달 관리 유틸리티
function openModal(id) {
const modal = document.getElementById(id);
modal.classList.remove('hidden');
modal.classList.add('flex');
}
​function closeModal(id) {
const modal = document.getElementById(id);
modal.classList.add('hidden');
modal.classList.remove('flex');
}
​// 체크리스트 렌더링
function renderChecklist() {
const container = document.getElementById('checklist-container');
container.innerHTML = '';
​if (appData.checklist.length === 0) {
container.innerHTML = <div class="text-center py-6 text-slate-400 text-xs">체크리스트 항목이 없습니다. 새로운 내용을 추가하세요.</div>;
return;
}
​appData.checklist.forEach(item => {
const itemDiv = document.createElement('div');
itemDiv.className = flex items-center justify-between p-3 rounded-xl border transition ${item.checked ? 'bg-slate-50 border-slate-200' : 'bg-white border-slate-200 shadow-xs'};
​itemDiv.innerHTML = <div class="flex items-center space-x-3 cursor-pointer flex-1" onclick="toggleCheck(${item.id})"> <div class="w-5 h-5 rounded border flex items-center justify-center transition-all ${item.checked ? 'bg-green-600 border-green-600 text-white' : 'border-slate-300 bg-white'}"> ${item.checked ?<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>: ''} </div> <span class="text-xs ${item.checked ? 'line-through text-slate-400' : 'text-slate-700 font-medium'}">${item.text}</span> </div> <button onclick="deleteCheckItem(${item.id})" class="text-slate-300 hover:text-red-500 p-1"> <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg> </button>;
container.appendChild(itemDiv);
});
}
​function toggleCheck(id) {
appData.checklist = appData.checklist.map(item => item.id === id ? { ...item, checked: !item.checked } : item);
saveData();
renderChecklist();
}
​function addChecklistItem(e) {
e.preventDefault();
const input = document.getElementById('new-check-item');
const text = input.value.trim();
if (!text) return;
​appData.checklist.push({
id: Date.now(),
text: text,
checked: false
});
saveData();
renderChecklist();
input.value = '';
}
​function deleteCheckItem(id) {
appData.checklist = appData.checklist.filter(item => item.id !== id);
saveData();
renderChecklist();
}
​function resetChecklist() {
appData.checklist = [...initChecklist];
saveData();
renderChecklist();
}
​// 공지사항 렌더링
function renderNotices() {
const container = document.getElementById('notice-list');
container.innerHTML = '';
​if (appData.notices.length === 0) {
container.innerHTML = <div class="bg-white p-6 text-center text-slate-400 text-xs rounded-2xl border border-slate-200">등록된 공지사항이 없습니다.</div>;
return;
}
​appData.notices.forEach(item => {
const isImportant = item.priority === 'important';
const card = document.createElement('div');
card.className = "bg-white p-4 rounded-2xl border border-slate-200 space-y-2 relative";
​card.innerHTML = <div class="flex justify-between items-start"> <div class="flex items-center space-x-2"> <span class="${isImportant ? 'bg-red-100 text-red-600' : 'bg-slate-100 text-slate-600'} text-[10px] font-bold px-2 py-0.5 rounded-full"> ${isImportant ? '긴급' : '안내'} </span> <span class="text-[10px] text-slate-400">${item.date}</span> </div> <button onclick="deleteNotice(${item.id})" class="text-slate-300 hover:text-red-500"> <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg> </button> </div> <h4 class="font-bold text-sm text-slate-900">${item.title}</h4> <p class="text-xs text-slate-600 leading-relaxed bg-slate-50 p-3 rounded-xl whitespace-pre-line">${item.content}</p>;
container.appendChild(card);
});
}
​function openNoticeModal() {
openModal('modal-notice');
}
​function submitNotice(e) {
e.preventDefault();
const priority = document.getElementById('notice-input-priority').value;
const title = document.getElementById('notice-input-title').value.trim();
const content = document.getElementById('notice-input-content').value.trim();
​appData.notices.unshift({
id: Date.now(),
priority,
title,
content,
date: new Date().toISOString().split('T')[0]
});
​saveData();
renderNotices();
closeModal('modal-notice');
​document.getElementById('notice-input-title').value = '';
document.getElementById('notice-input-content').value = '';
}
​function deleteNotice(id) {
appData.notices = appData.notices.filter(item => item.id !== id);
saveData();
renderNotices();
}
​// 게시판(위험 제보) 렌더링
function renderBoards() {
