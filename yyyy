​// 현장 메타 정보 변경 설정
function openSettings() {
document.getElementById('setting-input-site').value = appData.siteName;
document.getElementById('setting-input-date').value = appData.safetyStartDate;
openModal('modal-settings');
}
​function saveSettings() {
const site = document.getElementById('setting-input-site').value.trim();
const date = document.getElementById('setting-input-date').value;
